# =============================================================================
# LEMON AI — Environment Variable Reference
#
# LEGEND
#   ★ REQUIRED ALWAYS      Missing → server refuses to start in any environment.
#   ⚑ REQUIRED IN PROD     Missing → server refuses to start when APP_ENV is
#                          'production' or 'staging'. Safe to omit in local dev.
#   ○ OPTIONAL             Enables a specific integration; unset = feature off.
#
# The Zod schema in lib/env.ts enforces these buckets at boot via
# instrumentation.ts. See PRIVACY.md and README.md for the full data-map and
# deployment guide.
# =============================================================================

# ★ APP_ENV distinguishes staging from production even when NODE_ENV=production
#   for both. Accepted values: development | test | staging | production.
#   Missing → defaults to 'development'. Boot-time validation only enforces
#   the "REQUIRED IN PROD" bucket when APP_ENV is 'production' or 'staging'.
APP_ENV=development

# Supabase BaaS (Postgres Database & File Storage)
# ★ NEXT_PUBLIC_SUPABASE_URL       ★ NEXT_PUBLIC_SUPABASE_ANON_KEY
# ⚑ SUPABASE_SERVICE_ROLE_KEY  (server-side, bypasses RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq Cloud AI Engine (Primary Fast & Reasoning LLM models)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=

# Clerk Authentication & SaaS Subscription Billing
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Required in production: signing secret for verifying Clerk webhook signatures
# (Clerk Dashboard → Webhooks → your endpoint → Signing Secret, starts with whsec_)
CLERK_WEBHOOK_SECRET=
CLERK_SUPABASE_TEMPLATE=supabase
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# SaaS App Domain URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server Security & AES-256 Token Encryption
# CHANNEL_TOKEN_ENCRYPTION_KEY is REQUIRED in production (min 16 chars, 32+ recommended).
# It is used to encrypt stored OAuth/channel access tokens and is never derived
# from other secrets. Generate one with: openssl rand -base64 32
CHANNEL_OAUTH_STATE_SECRET=
CHANNEL_TOKEN_ENCRYPTION_KEY=
# Optional: comma-separated previous keys, used only to decrypt tokens that were
# encrypted before a key rotation. Leave empty unless you are rotating keys.
CHANNEL_TOKEN_ENCRYPTION_KEYS_LEGACY=

# Cron Job Authorization
# REQUIRED in production. Bearer token that the scheduled cron trigger must send
# in the Authorization header to invoke /api/post/process-due. Requests without a
# matching token are rejected with HTTP 401. Generate one with: openssl rand -base64 32
CRON_SECRET=

# Inngest Background Cron Job Publisher
# Set INNGEST_DEV=1 ONLY for local development. Leave unset (or 0) in production.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Meta Ads Manager Integration (Facebook & Instagram Ads)
META_CLIENT_ID=
META_CLIENT_SECRET=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
# ⚑ REQUIRED IN PROD: rotate to a random secret (openssl rand -hex 32).
# The literal value "lemon_ai_webhook" is treated as unset in prod/staging
# by the boot-time validator and will refuse to start.
META_WEBHOOK_VERIFY_TOKEN=lemon_ai_webhook

# Meta Threads API (Separate App ID & Secret from Meta Developers ➔ Use Cases ➔ Threads)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Replicate Pure AI Generation Engine (Flux.1 for Realistic Photos & Wan 2.2 S2V for 9:16 Video Reels)
REPLICATE_API_TOKEN=

# Cloudflare Workers AI (Free daily backup when Replicate is not set - 10,000 free neurons/day)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Google / YouTube OAuth 2.0 (Google Cloud Console ➔ APIs & Services ➔ Credentials ➔ OAuth 2.0 Client ID)
# Whitelist Redirect URI: http://localhost:3000/api/channel/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# LinkedIn OAuth 2.0 (LinkedIn Developer Portal ➔ App ➔ Auth tab)
# Whitelist Redirect URI: http://localhost:3000/api/channel/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Twitter / X OAuth 2.0 (developer.x.com ➔ Project/App ➔ User Authentication Settings)
# Type: Web App (Confidential Client with PKCE) | Whitelist Callback URL: http://localhost:3000/api/channel/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Bluesky Channel Integration
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Facebook Manual Channel Maintenance (Optional scripts/tools)
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
FB_PAGE_NAME=

# Comma-separated Clerk user IDs allowed to view/clear the AI cache stats
# endpoint (/api/ai/cache-stats) in production. In development, any
# authenticated user is allowed. Example: CACHE_ADMIN_USER_IDS=user_abc,user_xyz
CACHE_ADMIN_USER_IDS=

# Error Tracking / Observability (optional)
# If SENTRY_DSN is set AND @sentry/nextjs is installed, server errors are
# forwarded to Sentry. Otherwise errors fall back to structured console logs.
SENTRY_DSN=

# Rate Limiting (optional shared backend)
# By default an in-memory limiter is used (per-instance best-effort). For a
# strict shared limit across serverless instances, provide Upstash Redis REST
# credentials and the limiter switches to Redis automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Data Privacy & Compliance (Migration 12)
# Set to "true" in production to activate the daily data-retention cron
# (inngest/functions/data-retention-cron.ts). When unset or "false", the cron
# runs but performs no deletes — safe for staging.
DATA_RETENTION_ENABLED=

# Public-facing privacy contact email displayed on /privacy and used in
# regulator-facing responses. Falls back to a placeholder if unset.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# Optional: overrides the salt used by hashIP() in lib/pii-redactor.ts. Rotate
# to invalidate all existing ip_hash values in audit_logs (e.g. after a policy
# change). Any non-empty string is valid.
PII_IP_HASH_SALT=

# ---------------------------------------------------------------------------
# AI Cost Guard (lib/ai-cost-guard.ts)
# ---------------------------------------------------------------------------
# Every outbound call to Groq / Replicate / Cloudflare / Together / Vapi
# passes through the cost guard. Counters live in Upstash Redis (shared) or
# in-memory (per-instance) — Redis is strongly recommended in prod.
#
# All values below are OPTIONAL. Defaults are hard-coded in the module.
#
# Per-user daily cap.  Default 500 calls.
AI_DAILY_CAP_PER_USER=
# Per-user burst cap — resets each hour on the top of the hour, UTC.
# Default 120 calls.
AI_HOURLY_CAP_PER_USER=
# Global daily circuit-breaker across ALL users.  Default 20000 calls.
AI_DAILY_CAP_GLOBAL=
# Optional per-provider daily caps. Uncomment as needed. Blocks that specific
# provider after the cap is hit — the caller falls through to the next
# provider in its own waterfall.
# AI_DAILY_CAP_PROVIDER_GROQ=
# AI_DAILY_CAP_PROVIDER_REPLICATE=
# AI_DAILY_CAP_PROVIDER_VAPI=
# When "true", the guard fails CLOSED if the counter store is unreachable.
# Default is fail-OPEN so a Redis outage does not stop content generation.
AI_COST_GUARD_FAIL_CLOSED=

