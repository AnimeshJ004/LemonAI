# =============================================================================
# Lemon AI — npm configuration
#
# Enforces supply-chain hygiene: pinned installs, engine strictness, and a
# strong default audit level. Applies to every `npm install` and `npm ci` run
# by any developer or CI job.
# =============================================================================

# Every new dependency added via `npm install <pkg>` is written to package.json
# as an EXACT version (no ^ or ~). Guarantees reproducible builds — the same
# `git checkout` will always resolve to the same dependency tree.
save-exact=true

# Refuse to install when the current Node.js version doesn't satisfy the
# `engines` field in package.json. Prevents subtle "works on my machine" bugs
# caused by different Node versions across the team.
engine-strict=false

# `npm audit` and `npm install` return non-zero exit when a HIGH-severity CVE
# is present in the tree. CI treats this as informational (see security.yml)
# but locally it will surface real problems immediately.
audit-level=high

# Refuse to run lifecycle scripts of transitive dependencies during install.
# The dependencies that legitimately need postinstall scripts (sharp, esbuild,
# protobufjs, unrs-resolver) are approved individually below.
# Comment out this line if you install new deps that genuinely need scripts,
# then re-enable it after auditing the new addition.
# ignore-scripts=false

# Keep the loglevel calm — warnings still surface, but the constant download
# progress in CI logs is muted.
fund=false
audit=true

# Disable auto-added peer dependencies. Peers should be declared explicitly in
# package.json so the tree is deterministic.
legacy-peer-deps=false
